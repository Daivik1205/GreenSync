<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />

    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />

    <uses-permission android:name="com.google.android.gms.permission.CAR_FUEL" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_SPEED" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_MILEAGE" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <application
        android:name=".GreenSyncApp"
        android:label="GreenSync"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.GreenSync"
        android:allowBackup="true">

        <activity
            android:name=".screens.IntroActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".screens.DestinationPickerActivity"
            android:exported="false" />

        <activity
            android:name=".screens.RouteSelectionActivity"
            android:exported="false" />

        <activity
            android:name=".screens.HUDActivity"
            android:exported="false" />

        <activity
            android:name=".screens.VehicleActivity"
            android:exported="false" />

        <service
            android:name=".GreenSyncCarAppService"
            android:exported="true"
            android:label="GreenSync Nav">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <service
            android:name=".services.MqttIntentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".services.EcuTelemetryService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service android:name="org.eclipse.paho.android.service.MqttService" />

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="3" />

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>

</manifest>